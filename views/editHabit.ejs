<div class = "container">
    <h1>Edit Habit</h1>
    <div class = "form-card">
        <form action = "/habit/<%= habit._id %>/edit" class = "input-form" method = "POST">
            <label>Habit Name</label>
            <input type = "text" name = "habitName" value = "<%= habit.habitName %>" required>

            <label>Category</label>
            <input type = "text" name = "category" value = "<%= habit.category %>" required>

            <label>Frequency</label>
            <input type = "text" name = "frequency" value = "<%= habit.frequency %>" required>

            <button type = "submit">Save Changes</button>
        </form>
    </div>
</div>