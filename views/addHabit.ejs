<div class = "container">
    <h1>Add A Habit</h1>
    <div class = "form-card">
        <form action = "/add-habit" class = "input-form" method = "POST">
            <div style = "margin-bottom: 15px;">
                <label>Habit Name</label>
                <input type = "text" name = "habitName" placeholder="Exercise" required>
            </div>
            
            <div style = "margin-bottom: 15px;">

                <label>Category</label>
                <input type = "text" name = "category" placeholder="Fitness" required>

            </div>
            
            <div style = "margin-bottom: 15px;">
                <label>Frequency</label>
                <input type = "text" name = "frequency" placeholder="3x a week" required>
            </div>

            <div style = "margin-bottom: 15px;">
                <button type = "submit">Create Habit</button>
            </div>
            
        </form>
    </div>
</div>