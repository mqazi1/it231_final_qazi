<div class = "container">
    <h1>Add A Habit</h1>
    <div class = "content-box">
        <form action = "/add-habit" class = "addHabit-form" method = "POST">
            <label>Habit Name</label>
            <input type = "text" name = "habitName" placeholder="Exercise" />

            <label>Category</label>
            <input type = "text" name = "category" placeholder="Fitness" />

            <label>Frequency</label>
            <input type = "text" name = "frequency" placeholder="3x a week" />

            <button type = "submit">Submit</button>
        </form>
    </div>
</div>